-- Simple Remote Spam (no touching, no crashes)
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Networking = ReplicatedStorage:FindFirstChild("Packages") and ReplicatedStorage.Packages:FindFirstChild("Networking")
local CollectEvent = Networking and Networking:FindFirstChild("RE/Events/CollectEventSpawnable")

if not CollectEvent then
    warn("Remote not found")
    return
end

_G.SpamActive = false
_G.SpamDelay = 2  -- seconds between fires

local function fire()
    if not _G.SpamActive then return end
    pcall(function() CollectEvent:FireServer() end)
    print("[Spam] Fired CollectEventSpawnable")
end

-- Main loop
task.spawn(function()
    while true do
        fire()
        task.wait(_G.SpamDelay)
    end
end)

-- Toggle button
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "RemoteSpam"
screenGui.ResetOnSpawn = false
screenGui.Parent = game:CoreGui

local btn = Instance.new("TextButton")
btn.Size = UDim2.new(0, 200, 0, 50)
btn.Position = UDim2.new(0.5, -100, 0.85, 0)
btn.Text = "Start Spam"
btn.BackgroundColor3 = Color3.fromRGB(40,40,50)
btn.TextColor3 = Color3.new(1,1,1)
btn.Font = Enum.Font.GothamBold
btn.TextSize = 16
btn.Parent = screenGui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 12)
corner.Parent = btn

btn.MouseButton1Click:Connect(function()
    _G.SpamActive = not _G.SpamActive
    btn.Text = _G.SpamActive and "Stop Spam" : "Start Spam"
    btn.BackgroundColor3 = _G.SpamActive and Color3.fromRGB(0,180,0) or Color3.fromRGB(40,40,50)
    print(_G.SpamActive and "Spam started" or "Spam stopped")
end)

print("Remote spam ready. Click the button to start. Delay = 2 seconds (change _G.SpamDelay if needed).")
