    statusLabel = Instance.new("TextLabel")
    statusLabel.Name = "StatusLabel"
    statusLabel.Size = UDim2.new(1, 0, 0, 14)
    statusLabel.Position = UDim2.new(0.5, 0, 1, 6)
    statusLabel.AnchorPoint = Vector2.new(0.5, 0)
    statusLabel.BackgroundTransparency = 1
    statusLabel.Text = "READY"
    statusLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    statusLabel.TextSize = 11
    statusLabel.Font = Enum.Font.GothamBold
    statusLabel.TextStrokeTransparency = 0.4
    statusLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    statusLabel.ZIndex = 11
    statusLabel.Parent = button

    local function setButtonState(isReady)
        local targetColor = isReady and readyColor or cooldownColor
        if statusLabel then
            statusLabel.Text = isReady and "READY" or "WAIT"
        end
        TweenService:Create(button, tweenInfo, {BackgroundColor3 = targetColor}):Play()
    end

    local function instantShoot()
        if not canShoot then return end
        if not player.Character or not player.Character:FindFirstChild("Humanoid") then return end
        if not getWeapon() then return end

        local target = getNearestVisibleEnemy()
        if target and shootEnemy(target) then
            canShoot = false
            lastShotTime = tick()
            setButtonState(false)

            task.spawn(function()
                local scaleTween = TweenService:Create(button, TweenInfo.new(0.1, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                    Size = UDim2.new(0, 85, 0, 85)
                })
                scaleTween:Play()
                scaleTween.Completed:Connect(function()
                    TweenService:Create(button, TweenInfo.new(0.2, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out), {
                        Size = UDim2.new(0, 70, 0, 70)
                    }):Play()
                end)
                if icon then
                    TweenService:Create(icon, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut), {
                        Rotation = icon.Rotation + 360
                    }):Play()
                end
            end)

            task.spawn(function()
                while tick() - lastShotTime < cooldownTime do task.wait(0.1) end
                canShoot = true
                setButtonState(true)
            end)
        end
    end

    button.MouseButton1Down:Connect(instantShoot)
    button.TouchStarted:Connect(instantShoot)

    canShoot = true
    lastShotTime = 0
    setButtonState(true)
end

player.CharacterAdded:Connect(function()
    task.wait(0.1)
    createGUI()
end)

if player.Character then
    createGUI()
else
    player.CharacterAdded:Wait()
    createGUI()
end

print("Instant Aimbot loaded – shoots on press!")
