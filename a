btn.MouseButton1Click:Connect(function()
    _G.TestAutoCollect = not _G.TestAutoCollect
    btn.Text = _G.TestAutoCollect and "Stop Auto-Collect (Test)" or "Start Auto-Collect (Test)"
    btn.BackgroundColor3 = _G.TestAutoCollect and Color3.fromRGB(0,180,0) or Color3.fromRGB(40,40,50)
    if _G.TestAutoCollect then
        print("[Test] Auto‑collect ENABLED – will only touch pickups in your current map")
    else
        print("[Test] Auto‑collect DISABLED")
        collectedPickups = {}
    end
end)

