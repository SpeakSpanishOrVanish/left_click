-- Simple Spam of the working remote
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Packages = ReplicatedStorage:FindFirstChild("Packages")
if not Packages then warn("Packages not found") return end
local Networking = Packages:FindFirstChild("Networking")
if not Networking then warn("Networking not found") return end
local CollectEvent = Networking:FindFirstChild("RE/Events/CollectEventSpawnable")
if not CollectEvent then warn("CollectEvent not found") return end

_G.SpamActive = false
_G.SpamDelay = 2  -- seconds between fires

local function fire()
    if not _G.SpamActive then return end
    local success, err = pcall(function()
        CollectEvent:FireServer()
    end)
    if success then
        print("[Spam] Fired")
    else
        warn("[Spam] Error: " .. tostring(err))
    end
end

-- Spam loop
task.spawn(function()
    while true do
        fire()
        task.wait(_G.SpamDelay)
    end
end)

-- On‑screen toggle button
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "RemoteSpam"
screenGui.ResetOnSpawn = false
screenGui.Parent = game:CoreGui

local btn = Instance.new("TextButton")
btn.Size = UDim2.new(0, 200, 0, 50)
btn.Position = UDim2.new(0.5, -100, 0.85, 0)
btn.Text = "Start Spam"
btn.BackgroundColor3 = Color3.fromRGB(40,40,50)
btn.TextColor3 = Color3.new(1,1,1)
btn.Font = Enum.Font.GothamBold
btn.TextSize = 16
btn.Parent = screenGui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 12)
corner.Parent = btn

btn.MouseButton1Click:Connect(function()
    _G.SpamActive = not _G.SpamActive
    btn.Text = _G.SpamActive and "Stop Spam" or "Start Spam"
    btn.BackgroundColor3 = _G.SpamActive and Color3.fromRGB(0,180,0) or Color3.fromRGB(40,40,50)
    print(_G.SpamActive and "Spam started" or "Spam stopped")
end)

print("Ready. Click the button to start spamming every " .. _G.SpamDelay .. " seconds.")
