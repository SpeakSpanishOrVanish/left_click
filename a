-- NEW ESP (based on Team property) – unchanged
-- ================================
local espEnabled = false
local Enemy_Color = Color3.fromRGB(255, 0, 0) -- Red
local TeamCheck = true

local function ToggleESP(player, character)
    if not character then return end
    
    -- Remove existing highlight first
    local existing = character:FindFirstChild("Delta_ESP")
    if existing then existing:Destroy() end

    -- If ESP is disabled globally, don't add anything
    if not espEnabled then return end

    -- TEAM CHECK: If on same team, stop here (leaves ESP removed)
    if TeamCheck and player.Team ~= nil and player.Team == LocalPlayer.Team then
        return 
    end

    -- CREATE HIGHLIGHT (Enemies Only)
    local highlight = Instance.new("Highlight")
    highlight.Name = "Delta_ESP"
    highlight.Adornee = character
    highlight.FillColor = Enemy_Color
    highlight.FillTransparency = 0.5
    highlight.OutlineColor = Color3.new(1, 1, 1)
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Parent = character
end

local function MonitorPlayer(player)
    if player == LocalPlayer then return end

    -- Trigger when character spawns
    player.CharacterAdded:Connect(function(char)
        ToggleESP(player, char)
    end)

    -- Trigger if character already exists
    if player.Character then
        task.spawn(ToggleESP, player, player.Character)
    end

    -- Trigger if they change teams
    player:GetPropertyChangedSignal("Team"):Connect(function()
        ToggleESP(player, player.Character)
    end)
end

-- Function to refresh all players (used when toggling ESP on/off)
local function refreshAllESP()
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            ToggleESP(p, p.Character)
        end
    end
end

-- When you change teams, refresh everyone
LocalPlayer:GetPropertyChangedSignal("Team"):Connect(function()
    if espEnabled then
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                ToggleESP(p, p.Character)
            end
        end
    end
end)

-- Initialize monitoring (always active, but ESP only appears when enabled)
for _, p in pairs(Players:GetPlayers()) do
    MonitorPlayer(p)
end
Players.PlayerAdded:Connect(MonitorPlayer)

